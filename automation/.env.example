# ============================================================
# .env.example — 실제 사용 시 .env로 복사 후 값 채우기
# ============================================================

# Anthropic API 키 (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── 트렌드 리서처 (trend_researcher.py) ──────────────────────
# 네이버 Open API — 뉴스 검색으로 실시간 이슈 소재 자동 수집
# 발급: https://developers.naver.com → 애플리케이션 등록 → 검색 API 선택
# 무료 25,000회/일
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 카드뉴스 파이프라인 (card_news_pipeline.py) ──────────────
# Google AI Studio API 키 — 이미지 생성(Imagen)에 사용
# 발급: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Figma Personal Access Token — 프레임 조회에 사용
# 발급: Figma 우측 상단 프로필 → Settings → Security → Personal access tokens
FIGMA_TOKEN=

# Buffer API
# 발급 방법: python get_buffer_token.py 실행
BUFFER_ACCESS_TOKEN=
# Buffer에 연결된 Threads 채널 ID
BUFFER_CHANNEL_ID=

# Threads Insights API (Meta 개발자 앱)
# 발급 방법: python get_threads_token.py 실행 → 장기 토큰(60일) 저장
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=        # Meta 개발자 앱 → Threads API → 사용자 ID (숫자)
THREADS_APP_ID=
THREADS_APP_SECRET=

# 이미지 호스팅 (Threads 이미지 발행 시 필요 — 공개 URL 생성용)
# 발급: https://api.imgbb.com/ → 무료 가입 → API Key 발급
IMGBB_API_KEY=

# ── 유튜브 채널 분석 (youtube_analyzer.py) ──────────────────
# 1차 채널 (항상 분석) — 새 영상 있으면 스크립트 분석 → economy_news 소재 변환
YOUTUBE_CHANNELS_PRIMARY=@김영익,@howtoberich_official
# 2차 채널 (1차 소재가 3개 미만일 때만 추가 분석)
YOUTUBE_CHANNELS_FALLBACK=@hkwowtv

# 운영 시작일 (YYYY-MM-DD) — Phase 1/2/3 자동 계산 기준
START_DATE=2026-05-14

# ── 네이버 블로그 자동 발행 (naver_blog_poster.py) ──────────────
# 주의: 네이버 공식 발행 API는 2020년 종료됨 — 셀레니움으로 실제 로그인 후
# 브라우저를 조작해 발행하는 방식. 로컬 PC에서만 실행할 것(클라우드 IP는
# 네이버 보안 인증에 거의 확실히 막힘).
NAVER_BLOG_ID=
NAVER_BLOG_PW=

# ── 셀럽 트렌드 블로그 (run_celeb_pipeline.py) — 보험 블로그와 별개 계정 ──
# ⚠️ 반드시 NAVER_BLOG_ID/PW와 다른 키 이름을 써야 한다. 같은 키를 두 번 쓰면
# dotenv가 나중 값으로 덮어써 두 블로그 계정이 뒤섞인다(2026-07-13 실제 발생).
CELEB_NAVER_BLOG_ID=
CELEB_NAVER_BLOG_PW=

# Pexels API — 셀럽 블로그 맥락(무드) 이미지 검색용
# 발급: https://www.pexels.com/api/ → 즉시 셀프서비스 발급, 심사 없음
PEXELS_API_KEY=

# YouTube Data API v3 — 셀럽명 기반 관련 영상 자동 검색(공식 임베드로 본문 삽입)
# 발급: GOOGLE_API_KEY와 같은 GCP 프로젝트에서 아래 링크로 "사용 설정"만 누르면 됨
# https://console.cloud.google.com/apis/library/youtube.googleapis.com
# 비워두면 GOOGLE_API_KEY를 자동으로 재사용한다(config.py). 무료 쿼터 일 100회 검색.
YOUTUBE_API_KEY=

# Google Custom Search API — 인스타그램 게시물 URL 자동 발견(site:instagram.com/p/)
# ⚠️ 2026-01부로 신규 고객에게 완전 차단됨(403 PERMISSION_DENIED, 2026-07-15 재확인).
# celeb_assets.py는 더 이상 이 키를 쓰지 않는다 — 아래 SERPER_API_KEY로 대체됨.
# 과거 프로젝트에서 이미 발급받은 키가 있다면 값만 남겨둬도 무해하다.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# Serper.dev — 구글 검색결과 프록시 (2026-07-15 도입, 위 Google CSE 차단의 대체재)
# 발급: https://serper.dev → 가입 → 대시보드에서 API 키 발급 (가입 시 무료 크레딧 제공)
# 용도 1) 셀럽 블로그 이미지 검색 — 네이버 이미지 검색만으로 원하는 사진이 잘
#         안 나올 때 구글 이미지 검색 결과를 보조 소스로 추가(celeb_assets.py)
# 용도 2) site:instagram.com 검색 — 인스타그램 게시물 URL 자동 발견(oEmbed 임베드용)
#         + 인스타그램에 실제 게시된 사진 후보 확보(다운로드 후 기존 Vision 필터로 검증)
# 비워두면 두 기능 모두 조용히 건너뛰고 기존 소스(네이버 이미지 검색 등)만 사용한다.
SERPER_API_KEY=

# 발행 시각 (24시간 기준, KST)
MORNING_HOUR=7
MORNING_MINUTE=30
NOON_HOUR=12
NOON_MINUTE=30
EVENING_HOUR=21
EVENING_MINUTE=0
