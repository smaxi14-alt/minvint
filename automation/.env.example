# ============================================================
# .env.example — 실제 사용 시 .env로 복사 후 값 채우기
# ============================================================

# Anthropic API 키 (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Buffer API
# 발급 방법: python get_buffer_token.py 실행
BUFFER_ACCESS_TOKEN=
# Buffer에 연결된 Threads 프로필 ID (get_buffer_token.py 실행 시 자동 출력됨)
BUFFER_PROFILE_ID=

# 운영 시작일 (YYYY-MM-DD) — Phase 1/2/3 자동 계산 기준
START_DATE=2026-05-14

# 발행 시각 (24시간 기준, KST)
MORNING_HOUR=7
MORNING_MINUTE=30
NOON_HOUR=12
NOON_MINUTE=30
EVENING_HOUR=21
EVENING_MINUTE=0
